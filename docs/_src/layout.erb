<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#201523">
  <meta name="description" content="<%= description %>">
  <title><%= title %></title>
  <link rel="icon" href="<%= root %>assets/images/cherries.svg" type="image/svg+xml">
  <link rel="alternate" href="<%= root %>atom.xml" type="application/atom+xml" title="Ruby Facets releases">
  <link rel="stylesheet" href="<%= root %>assets/styles/site.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="shell header-inner">
      <a class="brand" href="<%= root %>index.html" aria-label="Ruby Facets home"><img class="brand-mark" src="<%= root %>assets/images/cherries.svg" alt=""><span>Ruby <strong>Facets</strong></span></a>
      <nav class="site-nav" aria-label="Main navigation">
        <a href="<%= root %>index.html" <%= 'aria-current="page"' if active == 'index' %>>Overview</a>
        <a href="<%= root %>learn.html" <%= 'aria-current="page"' if active == 'learn' %>>Guide</a>
        <a href="<%= root %>news.html" <%= 'aria-current="page"' if active == 'news' %>>Releases</a>
        <a href="<%= root %>source.html" <%= 'aria-current="page"' if active == 'source' %>>Contribute</a>
      </nav>
      <a class="header-github" href="https://github.com/rubyworks/facets">GitHub <span aria-hidden="true">↗</span></a>
    </div>
  </header>

  <main id="main"><%= content %></main>

  <footer class="site-footer">
    <div class="shell footer-inner">
      <div>
        <a class="brand" href="<%= root %>index.html"><img class="brand-mark" src="<%= root %>assets/images/cherries.svg" alt=""><span>Ruby <strong>Facets</strong></span></a>
        <p>More of Ruby, one method at a time.<br>Created by Thomas Sawyer and the Ruby community.</p>
      </div>
      <div class="footer-links" aria-label="More resources">
        <a href="https://rubygems.org/gems/facets">RubyGems</a>
        <a href="https://www.rubydoc.info/gems/facets">API reference</a>
        <a href="https://github.com/rubyworks/facets/issues">Issues</a>
        <a href="https://github.com/rubyworks/facets/blob/main/LICENSE.txt">BSD 2-Clause license</a>
      </div>
    </div>
  </footer>
</body>
</html>
